<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <application
        android:label="Pocketcrab"
        android:allowBackup="false"
        android:theme="@style/App">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Share Sheet entry: share any link/text to "Link Digest" -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Transparent trampoline: reads the clipboard (needs window focus) and queues the link -->
        <activity
            android:name=".ClipboardDigestActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Clip" />

        <!-- Quick Settings tile: copy a link, swipe down, tap -->
        <service
            android:name=".DigestTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile"
            android:label="Pinch link"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <service
            android:name=".WorkerService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>
</manifest>
